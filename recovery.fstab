# Production Recovery fstab for Infinix GT 20 Pro (X6871)
# Platform: MediaTek Dimensity 8200 Ultimate (MT6896 / MT6895)

# Logical Dynamic Partitions (Core 6)
system        /system       erofs    ro    wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system        /system       ext4     ro    wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext    /system_ext   erofs    ro    wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext    /system_ext   ext4     ro    wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
vendor        /vendor       erofs    ro    wait,slotselect,avb,logical,first_stage_mount
vendor        /vendor       ext4     ro    wait,slotselect,avb,logical,first_stage_mount
product       /product      erofs    ro    wait,slotselect,avb,logical,first_stage_mount
product       /product      ext4     ro    wait,slotselect,avb,logical,first_stage_mount
vendor_dlkm   /vendor_dlkm  erofs    ro    wait,slotselect,avb,logical,first_stage_mount
vendor_dlkm   /vendor_dlkm  ext4     ro    wait,slotselect,avb,logical,first_stage_mount
odm_dlkm      /odm_dlkm     erofs    ro    wait,slotselect,avb,logical,first_stage_mount
odm_dlkm      /odm_dlkm     ext4     ro    wait,slotselect,avb,logical,first_stage_mount

# Transsion Extension Logical Partitions (8 - erofs primary, ext4 fallback)
tr_mi         /tr_mi        erofs    ro    wait,slotselect,logical,first_stage_mount,nofail
tr_mi         /tr_mi        ext4     ro    wait,slotselect,logical,first_stage_mount,nofail
tr_theme      /tr_theme     erofs    ro    wait,slotselect,logical,first_stage_mount,nofail
tr_theme      /tr_theme     ext4     ro    wait,slotselect,logical,first_stage_mount,nofail
tr_region     /tr_region    erofs    ro    wait,slotselect,logical,first_stage_mount,nofail
tr_region     /tr_region    ext4     ro    wait,slotselect,logical,first_stage_mount,nofail
tr_company    /tr_company   erofs    ro    wait,slotselect,logical,first_stage_mount,nofail
tr_company    /tr_company   ext4     ro    wait,slotselect,logical,first_stage_mount,nofail
tr_carrier    /tr_carrier   erofs    ro    wait,slotselect,logical,first_stage_mount,nofail
tr_carrier    /tr_carrier   ext4     ro    wait,slotselect,logical,first_stage_mount,nofail
tr_product    /tr_product   erofs    ro    wait,slotselect,logical,first_stage_mount,nofail
tr_product    /tr_product   ext4     ro    wait,slotselect,logical,first_stage_mount,nofail
tr_preload    /tr_preload   erofs    ro    wait,slotselect,logical,first_stage_mount,nofail
tr_preload    /tr_preload   ext4     ro    wait,slotselect,logical,first_stage_mount,nofail
tr_overlayfs  /tr_overlayfs erofs    ro    wait,slotselect,logical,first_stage_mount,nofail
tr_overlayfs  /tr_overlayfs ext4     ro    wait,slotselect,logical,first_stage_mount,nofail

# Physical Core & Cryptographic Partitions
/dev/block/by-name/metadata  /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata  /data     f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,quota,latemount,resize,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/tranfs    /tranfs   ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable,nofail,first_stage_mount

# Physical MTK Platform Partitions (NVRAM, Calibration, Factory)
/dev/block/by-name/protect1  /protect_f ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/protect2  /protect_s ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/nvdata    /nvdata    ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable
/dev/block/by-name/nvcfg     /nvcfg     ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/persist   /persist   ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable

