#
# System Properties for Infinix GT 20 Pro (X6871) Recovery
#

# Hardware Platform (MT6896/Dimensity 8200 uses mt6895 BSP platform code)
ro.board.platform=mt6895
ro.hardware=mt6895
ro.product.board=Infinix-X6871

# Display & Refresh Rate Lock (Raydium RM69220 144Hz AMOLED)
ro.sf.lcd_density=480
ro.vendor.tran.display.pixelworks.support=1
ro.surface_flinger.set_idle_timer_ms=0
ro.surface_flinger.set_touch_timer_ms=0
ro.surface_flinger.set_display_power_timer_ms=0
debug.sf.fps=60

# Haptics Routing
sys.vibrator.path=/sys/class/leds/vibrator_single

# USB ConfigFS Controller
sys.usb.controller=11201000.usb0
sys.usb.configfs=1
sys.usb.ffs.aio_compat=0

# Dynamic Partitions
ro.boot.dynamic_partitions=true
ro.boot.boot_devices=bootdevice,112b0000.ufshci,soctype

# Virtual A/B Compression
ro.virtual_ab.enabled=true
ro.virtual_ab.compression.enabled=true

# Security & TEE Decryption
ro.crypto.state=encrypted
ro.crypto.type=file
